{
  "$defs": {
    "AgentConfiguration": {
      "additionalProperties": false,
      "properties": {
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "model",
        "model_version",
        "configuration_sha256"
      ],
      "title": "AgentConfiguration",
      "type": "object"
    },
    "AgentParticipant": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/AgentConfiguration"
        },
        "kind": {
          "const": "agent",
          "default": "agent",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "epistemics.participant.v1",
          "default": "epistemics.participant.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "configuration"
      ],
      "title": "AgentParticipant",
      "type": "object"
    },
    "CandidateSupport": {
      "additionalProperties": false,
      "properties": {
        "dimension_id": {
          "enum": [
            "evidence_weighting",
            "source_judgment",
            "belief_revision",
            "dependence_and_causal_reasoning",
            "uncertainty_and_calibration",
            "decision_consistency"
          ],
          "title": "Dimension Id",
          "type": "string"
        },
        "evaluation_needed": {
          "title": "Evaluation Needed",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "hypothesis": {
          "title": "Hypothesis",
          "type": "string"
        },
        "status": {
          "const": "untested",
          "default": "untested",
          "title": "Status",
          "type": "string"
        },
        "support": {
          "title": "Support",
          "type": "string"
        }
      },
      "required": [
        "dimension_id",
        "hypothesis",
        "support",
        "evaluation_needed",
        "evidence"
      ],
      "title": "CandidateSupport",
      "type": "object"
    },
    "Dimension": {
      "additionalProperties": false,
      "properties": {
        "dimension_id": {
          "enum": [
            "evidence_weighting",
            "source_judgment",
            "belief_revision",
            "dependence_and_causal_reasoning",
            "uncertainty_and_calibration",
            "decision_consistency"
          ],
          "title": "Dimension Id",
          "type": "string"
        },
        "evidence_status": {
          "enum": [
            "provisional",
            "insufficient_evidence"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/ObservationExample"
          },
          "title": "Examples",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "measurements": {
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "dimension_id",
        "title",
        "evidence_status",
        "summary",
        "limitations"
      ],
      "title": "Dimension",
      "type": "object"
    },
    "EvaluationConditions": {
      "additionalProperties": false,
      "properties": {
        "assistance": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assistance"
        },
        "context_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Policy"
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "instructions_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions Sha256"
        },
        "interface": {
          "default": "unspecified",
          "enum": [
            "mcp",
            "browser",
            "other",
            "unspecified"
          ],
          "title": "Interface",
          "type": "string"
        },
        "time_limit_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Limit Seconds"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        }
      },
      "title": "EvaluationConditions",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "const": "source-report",
          "default": "source-report",
          "title": "Artifact Id",
          "type": "string"
        },
        "json_pointer": {
          "pattern": "^/",
          "title": "Json Pointer",
          "type": "string"
        }
      },
      "required": [
        "json_pointer"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "HumanParticipant": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "human",
          "default": "human",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "epistemics.participant.v1",
          "default": "epistemics.participant.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id"
      ],
      "title": "HumanParticipant",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "interval_95": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval 95"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value",
        "unit",
        "method",
        "evidence"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "ObservationExample": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "description",
        "evidence"
      ],
      "title": "ObservationExample",
      "type": "object"
    },
    "SessionContext": {
      "additionalProperties": false,
      "description": "Public metadata boundary for future shared services; no trial truth or seeds.",
      "properties": {
        "accepted_answers": {
          "minimum": 0,
          "title": "Accepted Answers",
          "type": "integer"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "completion": {
          "enum": [
            "not_started",
            "partial",
            "complete"
          ],
          "title": "Completion",
          "type": "string"
        },
        "conditions": {
          "$ref": "#/$defs/EvaluationConditions"
        },
        "evaluator_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "metadata_verification": {
          "const": "operator_asserted",
          "default": "operator_asserted",
          "title": "Metadata Verification",
          "type": "string"
        },
        "participant": {
          "discriminator": {
            "mapping": {
              "agent": "#/$defs/AgentParticipant",
              "human": "#/$defs/HumanParticipant"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AgentParticipant"
            },
            {
              "$ref": "#/$defs/HumanParticipant"
            }
          ],
          "title": "Participant"
        },
        "planned_answers": {
          "exclusiveMinimum": 0,
          "title": "Planned Answers",
          "type": "integer"
        },
        "protocol_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Sha256",
          "type": "string"
        },
        "protocol_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "response_origin": {
          "default": "unspecified",
          "enum": [
            "agent",
            "human",
            "synthetic",
            "unspecified"
          ],
          "title": "Response Origin",
          "type": "string"
        },
        "schema_version": {
          "const": "epistemics.session-context.v1",
          "default": "epistemics.session-context.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "sharing": {
          "const": "private",
          "default": "private",
          "title": "Sharing",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "participant",
        "protocol_version",
        "protocol_sha256",
        "evaluator_version",
        "started_at",
        "completion",
        "accepted_answers",
        "planned_answers"
      ],
      "title": "SessionContext",
      "type": "object"
    },
    "SourceDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "analysis_version": {
          "const": "source-passport-diagnostics/0.1.0",
          "default": "source-passport-diagnostics/0.1.0",
          "title": "Analysis Version",
          "type": "string"
        },
        "fits": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Fits",
          "type": "object"
        },
        "intervention_benefit_tested": {
          "const": false,
          "default": false,
          "title": "Intervention Benefit Tested",
          "type": "boolean"
        },
        "parameters_are_validated_traits": {
          "const": false,
          "default": false,
          "title": "Parameters Are Validated Traits",
          "type": "boolean"
        },
        "personalized_prediction_validated": {
          "const": false,
          "default": false,
          "title": "Personalized Prediction Validated",
          "type": "boolean"
        }
      },
      "required": [
        "fits"
      ],
      "title": "SourceDiagnostics",
      "type": "object"
    },
    "SourceLearningArtifact": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "const": "private_local",
          "default": "private_local",
          "title": "Access",
          "type": "string"
        },
        "artifact_id": {
          "const": "source-report",
          "default": "source-report",
          "title": "Artifact Id",
          "type": "string"
        },
        "schema_version": {
          "const": "epistemics.source-evidence.v1",
          "default": "epistemics.source-evidence.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "validation": {
          "const": "schema_only_not_execution_verified",
          "default": "schema_only_not_execution_verified",
          "title": "Validation",
          "type": "string"
        }
      },
      "required": [
        "sha256"
      ],
      "title": "SourceLearningArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "condition": {
      "enum": [
        "sparse",
        "dense"
      ],
      "title": "Condition",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/SessionContext"
    },
    "coverage": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Coverage",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/Dimension"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Dimensions",
      "type": "array"
    },
    "interpretation_version": {
      "const": "passport-interpretation/0.4.0",
      "default": "passport-interpretation/0.4.0",
      "title": "Interpretation Version",
      "type": "string"
    },
    "issuance_status": {
      "const": "draft_unsigned",
      "default": "draft_unsigned",
      "title": "Issuance Status",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "model_diagnostics": {
      "$ref": "#/$defs/SourceDiagnostics"
    },
    "passport_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Passport Id",
      "type": "string"
    },
    "passport_version": {
      "const": "passport/0.4.0",
      "default": "passport/0.4.0",
      "title": "Passport Version",
      "type": "string"
    },
    "presentation": {
      "enum": [
        "structured",
        "packet",
        "unverified"
      ],
      "title": "Presentation",
      "type": "string"
    },
    "repeatability": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Repeatability",
      "type": "array"
    },
    "schema_version": {
      "const": "epistemics.passport.v4",
      "default": "epistemics.passport.v4",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "source_learning_provisional_profile",
      "default": "source_learning_provisional_profile",
      "title": "Scope",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceLearningArtifact"
    },
    "source_subject_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Source Subject Ids",
      "type": "array"
    },
    "subject_binding": {
      "enum": [
        "single_subject",
        "configuration_cohort"
      ],
      "title": "Subject Binding",
      "type": "string"
    },
    "support_candidates": {
      "items": {
        "$ref": "#/$defs/CandidateSupport"
      },
      "title": "Support Candidates",
      "type": "array"
    }
  },
  "required": [
    "passport_id",
    "created_at",
    "context",
    "source",
    "dimensions",
    "limitations",
    "subject_binding",
    "source_subject_ids",
    "presentation",
    "condition",
    "coverage",
    "repeatability",
    "model_diagnostics"
  ],
  "title": "SourcePassport",
  "type": "object"
}
