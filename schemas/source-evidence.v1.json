{
  "$defs": {
    "AgentConfiguration": {
      "additionalProperties": false,
      "properties": {
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "model",
        "model_version",
        "configuration_sha256"
      ],
      "title": "AgentConfiguration",
      "type": "object"
    },
    "AgentParticipant": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/AgentConfiguration"
        },
        "kind": {
          "const": "agent",
          "default": "agent",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "epistemics.participant.v1",
          "default": "epistemics.participant.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "configuration"
      ],
      "title": "AgentParticipant",
      "type": "object"
    },
    "EvaluationConditions": {
      "additionalProperties": false,
      "properties": {
        "assistance": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assistance"
        },
        "context_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Policy"
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        },
        "instructions_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions Sha256"
        },
        "interface": {
          "default": "unspecified",
          "enum": [
            "mcp",
            "browser",
            "other",
            "unspecified"
          ],
          "title": "Interface",
          "type": "string"
        },
        "time_limit_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Limit Seconds"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        }
      },
      "title": "EvaluationConditions",
      "type": "object"
    },
    "HumanParticipant": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "human",
          "default": "human",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "epistemics.participant.v1",
          "default": "epistemics.participant.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id"
      ],
      "title": "HumanParticipant",
      "type": "object"
    },
    "SessionContext": {
      "additionalProperties": false,
      "description": "Public metadata boundary for future shared services; no trial truth or seeds.",
      "properties": {
        "accepted_answers": {
          "minimum": 0,
          "title": "Accepted Answers",
          "type": "integer"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "completion": {
          "enum": [
            "not_started",
            "partial",
            "complete"
          ],
          "title": "Completion",
          "type": "string"
        },
        "conditions": {
          "$ref": "#/$defs/EvaluationConditions"
        },
        "evaluator_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "metadata_verification": {
          "const": "operator_asserted",
          "default": "operator_asserted",
          "title": "Metadata Verification",
          "type": "string"
        },
        "participant": {
          "discriminator": {
            "mapping": {
              "agent": "#/$defs/AgentParticipant",
              "human": "#/$defs/HumanParticipant"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AgentParticipant"
            },
            {
              "$ref": "#/$defs/HumanParticipant"
            }
          ],
          "title": "Participant"
        },
        "planned_answers": {
          "exclusiveMinimum": 0,
          "title": "Planned Answers",
          "type": "integer"
        },
        "protocol_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Sha256",
          "type": "string"
        },
        "protocol_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "response_origin": {
          "default": "unspecified",
          "enum": [
            "agent",
            "human",
            "synthetic",
            "unspecified"
          ],
          "title": "Response Origin",
          "type": "string"
        },
        "schema_version": {
          "const": "epistemics.session-context.v1",
          "default": "epistemics.session-context.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "sharing": {
          "const": "private",
          "default": "private",
          "title": "Sharing",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "participant",
        "protocol_version",
        "protocol_sha256",
        "evaluator_version",
        "started_at",
        "completion",
        "accepted_answers",
        "planned_answers"
      ],
      "title": "SessionContext",
      "type": "object"
    },
    "SourceSession": {
      "additionalProperties": false,
      "properties": {
        "report_json": {
          "title": "Report Json",
          "type": "string"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        },
        "transport_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Json"
        },
        "transport_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Sha256"
        }
      },
      "required": [
        "report_json",
        "report_sha256"
      ],
      "title": "SourceSession",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "condition": {
      "enum": [
        "sparse",
        "dense"
      ],
      "title": "Condition",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/SessionContext"
    },
    "coverage": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Coverage",
      "type": "object"
    },
    "diagnostics": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Diagnostics",
      "type": "object"
    },
    "facts": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Facts",
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "presentation": {
      "enum": [
        "structured",
        "packet",
        "unverified"
      ],
      "title": "Presentation",
      "type": "string"
    },
    "repeatability": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Repeatability",
      "type": "array"
    },
    "schema_version": {
      "const": "epistemics.source-evidence.v1",
      "default": "epistemics.source-evidence.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/SourceSession"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Sessions",
      "type": "array"
    },
    "source_subject_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Subject Ids",
      "type": "array"
    },
    "subject_binding": {
      "enum": [
        "single_subject",
        "configuration_cohort"
      ],
      "title": "Subject Binding",
      "type": "string"
    }
  },
  "required": [
    "context",
    "subject_binding",
    "source_subject_ids",
    "presentation",
    "condition",
    "sessions",
    "facts",
    "coverage",
    "repeatability",
    "diagnostics",
    "limitations"
  ],
  "title": "SourceCollection",
  "type": "object"
}
