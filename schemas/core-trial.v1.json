{
  "$defs": {
    "Analogue": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "underlying_growth_pct": {
          "title": "Underlying Growth Pct",
          "type": "number"
        },
        "rollout_disruption": {
          "title": "Rollout Disruption",
          "type": "boolean"
        },
        "backlog_score": {
          "title": "Backlog Score",
          "type": "number"
        },
        "renewal_growth_pct": {
          "title": "Renewal Growth Pct",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "underlying_growth_pct",
        "rollout_disruption",
        "backlog_score",
        "renewal_growth_pct"
      ],
      "title": "Analogue",
      "type": "object"
    },
    "ArchiveRow": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "reported_pct": {
          "title": "Reported Pct",
          "type": "number"
        },
        "audited_pct": {
          "title": "Audited Pct",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "reported_pct",
        "audited_pct"
      ],
      "title": "ArchiveRow",
      "type": "object"
    },
    "CalibrationTrial": {
      "additionalProperties": false,
      "properties": {
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        },
        "task": {
          "const": "evidence_integration",
          "default": "evidence_integration",
          "title": "Task",
          "type": "string"
        },
        "index": {
          "maximum": 23,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "instructions": {
          "title": "Instructions",
          "type": "string"
        },
        "stimulus": {
          "additionalProperties": true,
          "title": "Stimulus",
          "type": "object"
        }
      },
      "required": [
        "trial_id",
        "index",
        "instructions",
        "stimulus"
      ],
      "title": "CalibrationTrial",
      "type": "object"
    },
    "DiscoveryTrial": {
      "additionalProperties": false,
      "properties": {
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        },
        "task": {
          "const": "discovery",
          "default": "discovery",
          "title": "Task",
          "type": "string"
        },
        "index": {
          "maximum": 9,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "company": {
          "title": "Company",
          "type": "string"
        },
        "background": {
          "title": "Background",
          "type": "string"
        },
        "target_event": {
          "enum": [
            "growth_above_12",
            "growth_at_or_below_12"
          ],
          "title": "Target Event",
          "type": "string"
        },
        "instructions": {
          "title": "Instructions",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Sources",
          "type": "array"
        },
        "analogues": {
          "items": {
            "$ref": "#/$defs/Analogue"
          },
          "title": "Analogues",
          "type": "array"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/Document"
          },
          "maxItems": 9,
          "title": "Documents",
          "type": "array"
        },
        "source_probe_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Probe Ids",
          "type": "array"
        },
        "conditional_probe": {
          "title": "Conditional Probe",
          "type": "boolean"
        },
        "extraction_keys": {
          "items": {
            "type": "string"
          },
          "title": "Extraction Keys",
          "type": "array"
        },
        "gain": {
          "default": 2,
          "title": "Gain",
          "type": "number"
        },
        "loss": {
          "default": 1,
          "title": "Loss",
          "type": "number"
        }
      },
      "required": [
        "trial_id",
        "index",
        "company",
        "background",
        "target_event",
        "instructions",
        "sources",
        "analogues",
        "documents",
        "source_probe_ids",
        "conditional_probe",
        "extraction_keys"
      ],
      "title": "DiscoveryTrial",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "published_at": {
          "title": "Published At",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "source",
        "title",
        "published_at",
        "text",
        "content_sha256"
      ],
      "title": "Document",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "profile": {
          "title": "Profile",
          "type": "string"
        },
        "archive": {
          "items": {
            "$ref": "#/$defs/ArchiveRow"
          },
          "title": "Archive",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "name",
        "profile",
        "archive"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "trial_id": {
      "pattern": "^core-[0-9]{2}$",
      "title": "Trial Id",
      "type": "string"
    },
    "index": {
      "maximum": 33,
      "minimum": 0,
      "title": "Index",
      "type": "integer"
    },
    "module": {
      "enum": [
        "discovery",
        "calibration"
      ],
      "title": "Module",
      "type": "string"
    },
    "module_index": {
      "maximum": 23,
      "minimum": 0,
      "title": "Module Index",
      "type": "integer"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "discovery": "#/$defs/DiscoveryTrial",
          "evidence_integration": "#/$defs/CalibrationTrial"
        },
        "propertyName": "task"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DiscoveryTrial"
        },
        {
          "$ref": "#/$defs/CalibrationTrial"
        }
      ],
      "title": "Payload"
    }
  },
  "required": [
    "trial_id",
    "index",
    "module",
    "module_index",
    "payload"
  ],
  "title": "CoreTrial",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
