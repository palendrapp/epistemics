{
  "$defs": {
    "ArchiveCount": {
      "additionalProperties": false,
      "properties": {
        "auxiliary_event": {
          "title": "Auxiliary Event",
          "type": "boolean"
        },
        "companies": {
          "minimum": 0,
          "title": "Companies",
          "type": "integer"
        },
        "growth_above_10_percent": {
          "title": "Growth Above 10 Percent",
          "type": "boolean"
        }
      },
      "required": [
        "growth_above_10_percent",
        "auxiliary_event",
        "companies"
      ],
      "title": "ArchiveCount",
      "type": "object"
    },
    "CompanyRecord": {
      "additionalProperties": false,
      "properties": {
        "audited_revenue": {
          "exclusiveMinimum": 0,
          "title": "Audited Revenue",
          "type": "integer"
        },
        "company": {
          "title": "Company",
          "type": "string"
        },
        "initial_bulletin_revenue": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Bulletin Revenue"
        },
        "opening_backlog": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opening Backlog"
        },
        "prior_revenue": {
          "exclusiveMinimum": 0,
          "title": "Prior Revenue",
          "type": "integer"
        }
      },
      "required": [
        "company",
        "prior_revenue",
        "audited_revenue"
      ],
      "title": "CompanyRecord",
      "type": "object"
    },
    "SignalCount": {
      "additionalProperties": false,
      "properties": {
        "companies": {
          "minimum": 0,
          "title": "Companies",
          "type": "integer"
        },
        "growth_above_10_percent": {
          "title": "Growth Above 10 Percent",
          "type": "boolean"
        },
        "high_reading": {
          "title": "High Reading",
          "type": "boolean"
        }
      },
      "required": [
        "growth_above_10_percent",
        "high_reading",
        "companies"
      ],
      "title": "SignalCount",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_counts": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ArchiveCount"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Counts"
    },
    "archive_records": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CompanyRecord"
          },
          "maxItems": 20,
          "minItems": 20,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Records"
    },
    "auxiliary_event": {
      "title": "Auxiliary Event",
      "type": "string"
    },
    "auxiliary_resolved": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Auxiliary Resolved"
    },
    "battery_version": {
      "const": "auxiliary-diagnostic/0.2.0",
      "default": "auxiliary-diagnostic/0.2.0",
      "title": "Battery Version",
      "type": "string"
    },
    "company": {
      "title": "Company",
      "type": "string"
    },
    "documents": {
      "items": {
        "type": "string"
      },
      "title": "Documents",
      "type": "array"
    },
    "growth_resolved": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Growth Resolved"
    },
    "index": {
      "maximum": 3,
      "minimum": 0,
      "title": "Index",
      "type": "integer"
    },
    "instructions": {
      "title": "Instructions",
      "type": "string"
    },
    "request_conditionals": {
      "title": "Request Conditionals",
      "type": "boolean"
    },
    "schema_version": {
      "const": "epistemics.auxiliary-trial.v2",
      "default": "epistemics.auxiliary-trial.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "signal_history": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SignalCount"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signal History"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "trial_id": {
      "title": "Trial Id",
      "type": "string"
    }
  },
  "required": [
    "trial_id",
    "index",
    "stage",
    "company",
    "instructions",
    "auxiliary_event",
    "documents",
    "request_conditionals"
  ],
  "title": "Trial",
  "type": "object"
}
