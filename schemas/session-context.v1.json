{
  "$defs": {
    "AgentConfiguration": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "model",
        "model_version",
        "configuration_sha256"
      ],
      "title": "AgentConfiguration",
      "type": "object"
    },
    "AgentParticipant": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "epistemics.participant.v1",
          "default": "epistemics.participant.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "agent",
          "default": "agent",
          "title": "Kind",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "configuration": {
          "$ref": "#/$defs/AgentConfiguration"
        }
      },
      "required": [
        "subject_id",
        "configuration"
      ],
      "title": "AgentParticipant",
      "type": "object"
    },
    "EvaluationConditions": {
      "additionalProperties": false,
      "properties": {
        "interface": {
          "default": "unspecified",
          "enum": [
            "mcp",
            "browser",
            "other",
            "unspecified"
          ],
          "title": "Interface",
          "type": "string"
        },
        "context_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Policy"
        },
        "instructions_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions Sha256"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "assistance": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assistance"
        },
        "time_limit_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Limit Seconds"
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        }
      },
      "title": "EvaluationConditions",
      "type": "object"
    },
    "HumanParticipant": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "epistemics.participant.v1",
          "default": "epistemics.participant.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "human",
          "default": "human",
          "title": "Kind",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id"
      ],
      "title": "HumanParticipant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Public metadata boundary for future shared services; no trial truth or seeds.",
  "properties": {
    "schema_version": {
      "const": "epistemics.session-context.v1",
      "default": "epistemics.session-context.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "participant": {
      "discriminator": {
        "mapping": {
          "agent": "#/$defs/AgentParticipant",
          "human": "#/$defs/HumanParticipant"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AgentParticipant"
        },
        {
          "$ref": "#/$defs/HumanParticipant"
        }
      ],
      "title": "Participant"
    },
    "response_origin": {
      "default": "unspecified",
      "enum": [
        "agent",
        "human",
        "synthetic",
        "unspecified"
      ],
      "title": "Response Origin",
      "type": "string"
    },
    "metadata_verification": {
      "const": "operator_asserted",
      "default": "operator_asserted",
      "title": "Metadata Verification",
      "type": "string"
    },
    "protocol_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Protocol Version",
      "type": "string"
    },
    "protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Sha256",
      "type": "string"
    },
    "evaluator_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Evaluator Version",
      "type": "string"
    },
    "conditions": {
      "$ref": "#/$defs/EvaluationConditions"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "completion": {
      "enum": [
        "not_started",
        "partial",
        "complete"
      ],
      "title": "Completion",
      "type": "string"
    },
    "accepted_answers": {
      "minimum": 0,
      "title": "Accepted Answers",
      "type": "integer"
    },
    "planned_answers": {
      "exclusiveMinimum": 0,
      "title": "Planned Answers",
      "type": "integer"
    },
    "sharing": {
      "const": "private",
      "default": "private",
      "title": "Sharing",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "participant",
    "protocol_version",
    "protocol_sha256",
    "evaluator_version",
    "started_at",
    "completion",
    "accepted_answers",
    "planned_answers"
  ],
  "title": "SessionContext",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
