          "type": "string"
        },
        "kind": {
          "const": "human",
          "default": "human",
          "title": "Kind",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id"
      ],
      "title": "HumanParticipant",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "title": "N",
