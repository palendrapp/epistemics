        },
        "brier": {
          "title": "Brier",
          "type": "number"
        },
        "log_loss": {
          "title": "Log Loss",
          "type": "number"
        },
        "reference_rmse": {
          "title": "Reference Rmse",
          "type": "number"
        },
        "endpoint_reports": {
          "title": "Endpoint Reports",
          "type": "integer"
        }
      },
      "required": [
        "n",
        "brier",
        "log_loss",
        "reference_rmse",
        "endpoint_reports"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "trial": {
          "$ref": "#/$defs/Trial"
        },
        "answer": {
          "$ref": "#/$defs/Answer"
        },
        "answered_at": {
          "title": "Answered At",
          "type": "string"
        },
        "truth": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Truth",
          "type": "object"
        }
      },
      "required": [
        "trial",
        "answer",
        "answered_at",
        "truth"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ObserverComparison": {
      "additionalProperties": false,
      "properties": {
        "forecasts": {
          "items": {
            "$ref": "#/$defs/ObserverForecast"
          },
          "maxItems": 10,
          "minItems": 10,
          "title": "Forecasts",
          "type": "array"
        },
        "growth_report_rmse": {
          "title": "Growth Report Rmse",
          "type": "number"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "forecasts",
        "growth_report_rmse",
        "description"
      ],
      "title": "ObserverComparison",
      "type": "object"
    },
    "ObserverForecast": {
      "additionalProperties": false,
      "properties": {
        "growth_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Growth Probability",
          "type": "number"
        },
        "growth_quantiles_pct": {
          "$ref": "#/$defs/GrowthQuantiles"
        },
        "source_accuracy": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Source Accuracy",
          "type": "object"
        },
        "conditional_growth_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Conditional Growth Probability",
          "type": "number"
        },
        "disruption_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Disruption Probability",
          "type": "number"
        },
        "strong_disruption_link_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Strong Disruption Link Probability",
          "type": "number"
        },
        "shared_origin_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Shared Origin Probability",
          "type": "number"
        }
      },
      "required": [
        "growth_probability",
        "growth_quantiles_pct",
        "source_accuracy",
        "conditional_growth_probability",
        "disruption_probability",
        "strong_disruption_link_probability",
        "shared_origin_probability"
      ],
      "title": "ObserverForecast",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "properties": {
        "estimate": {
          "title": "Estimate",
          "type": "number"
        },
        "interval_95": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval 95"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "estimate",
        "method",
        "n"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "PrivateCase": {
      "additionalProperties": false,
      "properties": {
        "underlying_growth_pct": {
          "title": "Underlying Growth Pct",
          "type": "number"
        },
        "disruption": {
          "maximum": 1,
          "minimum": 0,
          "title": "Disruption",
          "type": "integer"
        },
        "relationship": {
          "maximum": 1,
          "minimum": 0,
          "title": "Relationship",
          "type": "integer"
        },
        "source_parameters": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "title": "Source Parameters",
          "type": "object"
        },
        "copied": {
          "title": "Copied",
          "type": "boolean"
        },
        "realized_growth_pct": {
          "title": "Realized Growth Pct",
          "type": "number"
        },
        "variant": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Variant",
          "type": "object"
        },
        "claim_ledger": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Claim Ledger",
          "type": "object"
        }
      },
      "required": [
        "underlying_growth_pct",
        "disruption",
        "relationship",
        "source_parameters",
        "copied",
        "realized_growth_pct",
        "variant",
        "claim_ledger"
      ],
      "title": "PrivateCase",
      "type": "object"
    },
    "SessionContext": {
      "additionalProperties": false,
      "description": "Public metadata boundary for future shared services; no trial truth or seeds.",
      "properties": {
        "schema_version": {
          "const": "epistemics.session-context.v1",
          "default": "epistemics.session-context.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "participant": {
          "discriminator": {
            "mapping": {
              "agent": "#/$defs/AgentParticipant",
              "human": "#/$defs/HumanParticipant"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AgentParticipant"
            },
            {
              "$ref": "#/$defs/HumanParticipant"
            }
          ],
          "title": "Participant"
        },
        "response_origin": {
          "default": "unspecified",
          "enum": [
            "agent",
            "human",
            "synthetic",
            "unspecified"
          ],
          "title": "Response Origin",
          "type": "string"
        },
        "metadata_verification": {
          "const": "operator_asserted",
          "default": "operator_asserted",
          "title": "Metadata Verification",
          "type": "string"
        },
        "protocol_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        },
        "protocol_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Sha256",
          "type": "string"
        },
        "evaluator_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "conditions": {
          "$ref": "#/$defs/EvaluationConditions"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "completion": {
          "enum": [
            "not_started",
            "partial",
            "complete"
          ],
          "title": "Completion",
          "type": "string"
        },
        "accepted_answers": {
          "minimum": 0,
          "title": "Accepted Answers",
          "type": "integer"
        },
        "planned_answers": {
          "exclusiveMinimum": 0,
          "title": "Planned Answers",
          "type": "integer"
        },
        "sharing": {
          "const": "private",
          "default": "private",
          "title": "Sharing",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "participant",
        "protocol_version",
        "protocol_sha256",
        "evaluator_version",
        "started_at",
        "completion",
        "accepted_answers",
        "planned_answers"
      ],
      "title": "SessionContext",
      "type": "object"
