{
  "$defs": {
    "AgentConfiguration": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "model",
        "model_version",
        "configuration_sha256"
      ],
      "title": "AgentConfiguration",
      "type": "object"
    },
    "AgentParticipant": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "epistemics.participant.v1",
          "default": "epistemics.participant.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "agent",
          "default": "agent",
          "title": "Kind",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "configuration": {
          "$ref": "#/$defs/AgentConfiguration"
        }
      },
      "required": [
        "subject_id",
        "configuration"
      ],
      "title": "AgentParticipant",
      "type": "object"
    },
    "Analogue": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "underlying_growth_pct": {
          "title": "Underlying Growth Pct",
          "type": "number"
        },
        "rollout_disruption": {
          "title": "Rollout Disruption",
          "type": "boolean"
        },
        "backlog_score": {
          "title": "Backlog Score",
          "type": "number"
        },
        "renewal_growth_pct": {
          "title": "Renewal Growth Pct",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "underlying_growth_pct",
        "rollout_disruption",
        "backlog_score",
        "renewal_growth_pct"
      ],
      "title": "Analogue",
      "type": "object"
    },
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "source_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Probability"
        }
      },
      "required": [
        "probability"
      ],
      "title": "Answer",
      "type": "object"
    },
    "ArchiveRow": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "reported_pct": {
          "title": "Reported Pct",
          "type": "number"
        },
        "audited_pct": {
          "title": "Audited Pct",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "reported_pct",
        "audited_pct"
      ],
      "title": "ArchiveRow",
      "type": "object"
    },
    "CalibrationResult": {
      "additionalProperties": false,
      "properties": {
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 24,
          "minItems": 24,
          "title": "Observations",
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/Parameter"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "observations",
        "metrics",
        "parameters"
      ],
      "title": "CalibrationResult",
      "type": "object"
    },
    "DiscoveryAnswer": {
      "additionalProperties": false,
      "properties": {
        "target_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Target Probability",
          "type": "number"
        },
        "growth_quantiles_pct": {
          "$ref": "#/$defs/GrowthQuantiles"
        },
        "decision": {
          "enum": [
            "invest",
            "hold"
          ],
          "title": "Decision",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 9,
          "title": "Evidence Ids",
          "type": "array"
        },
        "source_accuracy": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Source Accuracy",
          "type": "object"
        },
        "conditional_growth_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditional Growth Probability"
        },
        "extracted_values": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Extracted Values",
          "type": "object"
        },
        "alternative_explanation": {
          "anyOf": [
            {
              "maxLength": 1200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternative Explanation"
        }
      },
      "required": [
        "target_probability",
        "growth_quantiles_pct",
        "decision",
        "evidence_ids"
      ],
      "title": "DiscoveryAnswer",
      "type": "object"
    },
    "DiscoveryObservation": {
      "additionalProperties": false,
      "properties": {
        "trial": {
          "$ref": "#/$defs/DiscoveryTrial"
        },
        "answer": {
          "$ref": "#/$defs/DiscoveryAnswer"
        },
        "answered_at": {
          "title": "Answered At",
          "type": "string"
        }
      },
      "required": [
        "trial",
        "answer",
        "answered_at"
      ],
      "title": "DiscoveryObservation",
      "type": "object"
    },
    "DiscoveryResult": {
      "additionalProperties": false,
      "properties": {
        "observations": {
          "items": {
            "$ref": "#/$defs/DiscoveryObservation"
          },
          "maxItems": 10,
          "minItems": 10,
          "title": "Observations",
          "type": "array"
        },
        "private_case": {
          "$ref": "#/$defs/PrivateCase"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "observer_models": {
          "additionalProperties": {
            "$ref": "#/$defs/ObserverComparison"
          },
          "title": "Observer Models",
          "type": "object"
        },
        "observer_assumptions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              }
            ]
          },
          "title": "Observer Assumptions",
          "type": "object"
        }
      },
      "required": [
        "observations",
        "private_case",
        "metrics",
        "observer_models",
        "observer_assumptions"
      ],
      "title": "DiscoveryResult",
      "type": "object"
    },
    "DiscoveryTrial": {
      "additionalProperties": false,
      "properties": {
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        },
        "task": {
          "const": "discovery",
          "default": "discovery",
          "title": "Task",
          "type": "string"
        },
        "index": {
          "maximum": 9,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "company": {
          "title": "Company",
          "type": "string"
        },
        "background": {
          "title": "Background",
          "type": "string"
        },
        "target_event": {
          "enum": [
            "growth_above_12",
            "growth_at_or_below_12"
          ],
          "title": "Target Event",
          "type": "string"
        },
        "instructions": {
          "title": "Instructions",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Sources",
          "type": "array"
        },
        "analogues": {
          "items": {
            "$ref": "#/$defs/Analogue"
          },
          "title": "Analogues",
          "type": "array"
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/Document"
          },
          "maxItems": 9,
          "title": "Documents",
          "type": "array"
        },
        "source_probe_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Probe Ids",
          "type": "array"
        },
        "conditional_probe": {
          "title": "Conditional Probe",
          "type": "boolean"
        },
        "extraction_keys": {
          "items": {
            "type": "string"
          },
          "title": "Extraction Keys",
          "type": "array"
        },
        "gain": {
          "default": 2,
          "title": "Gain",
          "type": "number"
        },
        "loss": {
          "default": 1,
          "title": "Loss",
          "type": "number"
        }
      },
      "required": [
        "trial_id",
        "index",
        "company",
        "background",
        "target_event",
        "instructions",
        "sources",
        "analogues",
        "documents",
        "source_probe_ids",
        "conditional_probe",
        "extraction_keys"
      ],
      "title": "DiscoveryTrial",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "published_at": {
          "title": "Published At",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "source",
        "title",
        "published_at",
        "text",
        "content_sha256"
      ],
      "title": "Document",
      "type": "object"
    },
    "EvaluationConditions": {
      "additionalProperties": false,
      "properties": {
        "interface": {
          "default": "unspecified",
          "enum": [
            "mcp",
            "browser",
            "other",
            "unspecified"
          ],
          "title": "Interface",
          "type": "string"
        },
        "context_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Policy"
        },
        "instructions_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions Sha256"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "assistance": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assistance"
        },
        "time_limit_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Limit Seconds"
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Seconds"
        }
      },
      "title": "EvaluationConditions",
      "type": "object"
    },
    "GrowthQuantiles": {
      "additionalProperties": false,
      "properties": {
        "p10": {
          "title": "P10",
          "type": "number"
        },
        "p50": {
          "title": "P50",
          "type": "number"
        },
        "p90": {
          "title": "P90",
          "type": "number"
        }
      },
      "required": [
        "p10",
        "p50",
        "p90"
      ],
      "title": "GrowthQuantiles",
      "type": "object"
    },
    "HumanParticipant": {
      "additionalProperties": false,
