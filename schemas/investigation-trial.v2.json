{
  "$defs": {
    "Analogue": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "underlying_growth_pct": {
          "title": "Underlying Growth Pct",
          "type": "number"
        },
        "rollout_disruption": {
          "title": "Rollout Disruption",
          "type": "boolean"
        },
        "backlog_score": {
          "title": "Backlog Score",
          "type": "number"
        },
        "renewal_growth_pct": {
          "title": "Renewal Growth Pct",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "underlying_growth_pct",
        "rollout_disruption",
        "backlog_score",
        "renewal_growth_pct"
      ],
      "title": "Analogue",
      "type": "object"
    },
    "ArchiveRow": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "reported_pct": {
          "title": "Reported Pct",
          "type": "number"
        },
        "audited_pct": {
          "title": "Audited Pct",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "reported_pct",
        "audited_pct"
      ],
      "title": "ArchiveRow",
      "type": "object"
    },
    "QueryOption": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "enum": [
            "source_audit",
            "operations_check",
            "segment_check",
            "calculation",
            "stop"
          ],
          "title": "Query",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "cost": {
          "minimum": 0,
          "title": "Cost",
          "type": "number"
        }
      },
      "required": [
        "query",
        "description",
        "cost"
      ],
      "title": "QueryOption",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "epistemics.investigation-trial.v2",
      "default": "epistemics.investigation-trial.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "battery_version": {
      "const": "company-investigation/0.2.0",
      "default": "company-investigation/0.2.0",
      "title": "Battery Version",
      "type": "string"
    },
    "trial_id": {
      "title": "Trial Id",
      "type": "string"
    },
    "index": {
      "maximum": 3,
      "minimum": 0,
      "title": "Index",
      "type": "integer"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "mode": {
      "enum": [
        "discovery",
        "calibration"
      ],
      "title": "Mode",
      "type": "string"
    },
    "company": {
      "default": "Alder Systems",
      "title": "Company",
      "type": "string"
    },
    "instructions": {
      "title": "Instructions",
      "type": "string"
    },
    "source_archive": {
      "items": {
        "$ref": "#/$defs/ArchiveRow"
      },
      "title": "Source Archive",
      "type": "array"
    },
    "analogues": {
      "items": {
        "$ref": "#/$defs/Analogue"
      },
      "title": "Analogues",
      "type": "array"
    },
    "transcription_checked": {
      "title": "Transcription Checked",
      "type": "boolean"
    },
    "reported_growth_pct": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reported Growth Pct"
    },
    "correction_offset_pct": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correction Offset Pct"
    },
    "selected_query": {
      "anyOf": [
        {
          "enum": [
            "source_audit",
            "operations_check",
            "segment_check",
            "calculation",
            "stop"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Query"
    },
    "query_result": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query Result"
    },
    "documents": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Documents",
      "type": "array"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/QueryOption"
      },
      "title": "Options",
      "type": "array"
    },
    "expectation_queries": {
      "items": {
        "type": "string"
      },
      "title": "Expectation Queries",
      "type": "array"
    },
    "gain": {
      "exclusiveMinimum": 0,
      "title": "Gain",
      "type": "number"
    },
    "loss": {
      "exclusiveMinimum": 0,
      "title": "Loss",
      "type": "number"
    },
    "reference_assumptions": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Assumptions"
    }
  },
  "required": [
    "trial_id",
    "index",
    "stage",
    "mode",
    "instructions",
    "source_archive",
    "analogues",
    "transcription_checked",
    "documents",
    "options",
    "expectation_queries",
    "gain",
    "loss"
  ],
  "title": "Trial",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
