{
  "$defs": {
    "AgentConfiguration": {
      "additionalProperties": false,
      "properties": {
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "model",
        "model_version",
        "configuration_sha256"
      ],
      "title": "AgentConfiguration",
      "type": "object"
    },
    "AgentParticipant": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/AgentConfiguration"
        },
        "kind": {
          "const": "agent",
          "default": "agent",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "epistemics.participant.v1",
          "default": "epistemics.participant.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "configuration"
      ],
      "title": "AgentParticipant",
      "type": "object"
    },
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "auxiliary_if_growth": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auxiliary If Growth"
        },
        "auxiliary_if_no_growth": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auxiliary If No Growth"
        },
        "auxiliary_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Auxiliary Probability",
          "type": "number"
        },
        "growth_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Growth Probability",
          "type": "number"
        }
      },
      "required": [
        "growth_probability",
        "auxiliary_probability"
      ],
      "title": "Answer",
      "type": "object"
    },
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "assignment_id": {
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Assignment Id",
          "type": "string"
        },
        "auxiliary_outcome": {
          "title": "Auxiliary Outcome",
          "type": "boolean"
        },
        "growth_outcome": {
          "title": "Growth Outcome",
          "type": "boolean"
        },
        "pair_id": {
          "title": "Pair Id",
          "type": "string"
        },
        "relationship": {
          "enum": [
            "associated",
            "independent"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "target": {
          "enum": [
            "backlog",
            "source"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "assignment_id",
        "pair_id",
        "target",
        "relationship",
        "growth_outcome",
        "auxiliary_outcome"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "HumanParticipant": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "human",
          "default": "human",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "epistemics.participant.v1",
          "default": "epistemics.participant.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id"
      ],
      "title": "HumanParticipant",
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "items": {
            "$ref": "#/$defs/Assignment"
          },
          "maxItems": 8,
          "minItems": 8,
          "title": "Assignments",
          "type": "array"
        },
        "battery_version": {
          "const": "auxiliary-diagnostic/0.1.0",
          "default": "auxiliary-diagnostic/0.1.0",
          "title": "Battery Version",
          "type": "string"
        },
        "context_policy": {
          "enum": [
            "independent_episode_no_cross_case_history",
            "human_continuous_separate_company_cases"
          ],
          "title": "Context Policy",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "design_seed": {
          "minimum": 0,
          "title": "Design Seed",
          "type": "integer"
        },
        "evaluator_version": {
          "const": "auxiliary-diagnostic-evaluator/0.1.0",
          "default": "auxiliary-diagnostic-evaluator/0.1.0",
          "title": "Evaluator Version",
          "type": "string"
        },
        "execution_verification": {
          "const": "operator_asserted",
          "default": "operator_asserted",
          "title": "Execution Verification",
          "type": "string"
        },
        "implementation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation Sha256",
          "type": "string"
        },
        "participant": {
          "discriminator": {
            "mapping": {
              "agent": "#/$defs/AgentParticipant",
              "human": "#/$defs/HumanParticipant"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AgentParticipant"
            },
            {
              "$ref": "#/$defs/HumanParticipant"
            }
          ],
          "title": "Participant"
        },
        "purpose": {
          "const": "development_only",
          "default": "development_only",
          "title": "Purpose",
          "type": "string"
        },
        "response_origin": {
          "enum": [
            "human",
            "agent",
            "synthetic"
          ],
          "title": "Response Origin",
          "type": "string"
        },
        "schema_version": {
          "const": "epistemics.auxiliary-collection.v1",
          "default": "epistemics.auxiliary-collection.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "study_id": {
          "title": "Study Id",
          "type": "string"
        }
      },
      "required": [
        "study_id",
        "created_at",
        "design_seed",
        "implementation_sha256",
        "participant",
        "response_origin",
        "context_policy",
        "assignments"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "$ref": "#/$defs/Answer"
        },
        "answered_at": {
          "title": "Answered At",
          "type": "string"
        },
        "trial": {
          "$ref": "#/$defs/Trial"
        }
      },
      "required": [
        "trial",
        "answer",
        "answered_at"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Trial": {
      "additionalProperties": false,
      "properties": {
        "archive": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "object"
          },
          "title": "Archive",
          "type": "array"
        },
        "auxiliary_event": {
          "title": "Auxiliary Event",
          "type": "string"
        },
        "auxiliary_resolved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auxiliary Resolved"
        },
        "battery_version": {
          "const": "auxiliary-diagnostic/0.1.0",
          "default": "auxiliary-diagnostic/0.1.0",
          "title": "Battery Version",
          "type": "string"
        },
        "company": {
          "title": "Company",
          "type": "string"
        },
        "documents": {
          "items": {
            "type": "string"
          },
          "title": "Documents",
          "type": "array"
        },
        "growth_resolved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Growth Resolved"
        },
        "index": {
          "maximum": 3,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "instructions": {
          "title": "Instructions",
          "type": "string"
        },
        "request_conditionals": {
          "title": "Request Conditionals",
          "type": "boolean"
        },
        "schema_version": {
          "const": "epistemics.auxiliary-trial.v1",
          "default": "epistemics.auxiliary-trial.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "trial_id": {
          "title": "Trial Id",
          "type": "string"
        }
      },
      "required": [
        "trial_id",
        "index",
        "stage",
        "company",
        "instructions",
        "auxiliary_event",
        "archive",
        "documents",
        "request_conditionals"
      ],
      "title": "Trial",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "additionalProperties": true,
      "title": "Analysis",
      "type": "object"
    },
    "cases": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Observation"
        },
        "type": "array"
      },
      "title": "Cases",
      "type": "object"
    },
    "completed_at": {
      "title": "Completed At",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "manifest": {
      "$ref": "#/$defs/Manifest"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "epistemics.auxiliary-report.v1",
      "default": "epistemics.auxiliary-report.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "manifest",
    "manifest_sha256",
    "completed_at",
    "cases",
    "analysis",
    "limitations"
  ],
  "title": "Report",
  "type": "object"
}
